---
/**
 * Figure gallery: one large "stage" plus a thumbnail rail.
 * Selecting a thumbnail swaps the stage. Images open in a full-screen viewer with
 * their caption; videos play inline in a Plyr player (controls, fullscreen).
 * Figures sit on uniform plates and are never cropped (object-fit: contain).
 */
import 'plyr/dist/plyr.css';

import { withBase } from '@utils/base';

export interface GalleryFigure {
  src: string;
  type?: 'image' | 'video';
  poster?: string;
  caption: string;
  alt?: string;
}

interface Props {
  figures: GalleryFigure[];
}

const { figures } = Astro.props;

/** Small pre-generated thumbnail: /assets/img/thumbs/<basename>.jpg */
const thumbOf = (path: string) =>
  withBase(
    `/assets/img/thumbs/${path
      .split('/')
      .pop()
      ?.replace(/\.[^.]+$/, '')}.jpg`,
  );

const items = figures.map((f) => {
  const type = f.type ?? 'image';
  return {
    ...f,
    type,
    url: withBase(f.src),
    posterUrl: f.poster ? withBase(f.poster) : undefined,
    thumbUrl: type === 'video' ? (f.poster ? thumbOf(f.poster) : undefined) : thumbOf(f.src),
    alt: f.alt ?? f.caption,
  };
});
---

<div class="gallery" data-gallery>
  <div class="stage">
    {
      items.map((f, i) =>
        f.type === 'video' ? (
          <div class:list={['plate', 'stage-item', 'is-video', { active: i === 0 }]} data-index={i}>
            <video
              class="js-player"
              src={f.url}
              poster={f.posterUrl}
              playsinline
              preload="none"
              aria-label={f.alt}
            />
          </div>
        ) : (
          <button
            type="button"
            class:list={['plate', 'stage-item', { active: i === 0 }]}
            data-index={i}
            data-full={f.url}
            data-caption={f.caption}
            aria-label={`Enlarge: ${f.alt}`}
            tabindex={i === 0 ? 0 : -1}
          >
            <img src={f.url} alt={f.alt} loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
            <span class="zoom-hint">Click to enlarge</span>
          </button>
        ),
      )
    }
  </div>
  <p class="stage-caption">{items[0]?.caption}</p>

  {
    items.length > 1 && (
      <ol class="thumbs" aria-label="Figures">
        {items.map((f, i) => (
          <li>
            <button
              type="button"
              class:list={['plate', 'thumb', { active: i === 0 }]}
              data-index={i}
              data-caption={f.caption}
              aria-label={`Show: ${f.alt}`}
            >
              {f.thumbUrl ? (
                <img
                  src={f.thumbUrl}
                  alt=""
                  loading="lazy"
                  decoding="async"
                  onerror={`this.onerror=null;this.src='${f.posterUrl ?? f.url}'`}
                />
              ) : (
                <span class="thumb-video">Video</span>
              )}
              {f.type === 'video' && (
                <span class="thumb-play" aria-hidden="true">
                  <svg viewBox="0 0 16 16" width="10" height="10">
                    <path d="M4 2.5v11l9-5.5z" fill="currentColor" />
                  </svg>
                </span>
              )}
            </button>
          </li>
        ))}
      </ol>
    )
  }
</div>

<script>
  import Plyr from 'plyr';

  type Item = { full: string; caption: string };

  const players = new WeakMap<HTMLVideoElement, Plyr>();
  let lb: HTMLDivElement | null = null;
  let lbItems: Item[] = [];
  let lbIndex = 0;
  let lastFocus: HTMLElement | null = null;

  function ensureLightbox(): HTMLDivElement {
    if (lb && document.body.contains(lb)) return lb;
    lb = document.createElement('div');
    lb.className = 'lightbox';
    lb.setAttribute('role', 'dialog');
    lb.setAttribute('aria-modal', 'true');
    lb.setAttribute('aria-label', 'Figure viewer');
    lb.hidden = true;

    const mk = (cls: string, label: string, text: string) => {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = cls;
      b.setAttribute('aria-label', label);
      b.textContent = text;
      return b;
    };
    const close = mk('lb-close', 'Close', '×');
    const prev = mk('lb-nav lb-prev', 'Previous figure', '‹');
    const next = mk('lb-nav lb-next', 'Next figure', '›');
    const media = document.createElement('div');
    media.className = 'lb-media';
    const cap = document.createElement('p');
    cap.className = 'lb-caption';

    lb.append(close, prev, media, next, cap);
    document.body.appendChild(lb);

    close.addEventListener('click', closeLightbox);
    prev.addEventListener('click', () => show(lbIndex - 1));
    next.addEventListener('click', () => show(lbIndex + 1));
    lb.addEventListener('click', (e) => {
      if (e.target === lb) closeLightbox();
    });
    document.addEventListener('keydown', (e) => {
      if (!lb || lb.hidden) return;
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowLeft') show(lbIndex - 1);
      if (e.key === 'ArrowRight') show(lbIndex + 1);
    });
    return lb;
  }

  function show(i: number) {
    if (!lb || lbItems.length === 0) return;
    lbIndex = (i + lbItems.length) % lbItems.length;
    const it = lbItems[lbIndex];
    const media = lb.querySelector('.lb-media') as HTMLDivElement;
    const img = document.createElement('img');
    img.src = it.full;
    img.alt = it.caption;
    media.replaceChildren(img);
    (lb.querySelector('.lb-caption') as HTMLParagraphElement).textContent = it.caption;
    const multi = lbItems.length > 1;
    (lb.querySelector('.lb-prev') as HTMLElement).hidden = !multi;
    (lb.querySelector('.lb-next') as HTMLElement).hidden = !multi;
  }

  function openLightbox(items: Item[], i: number) {
    lastFocus = document.activeElement as HTMLElement | null;
    const box = ensureLightbox();
    lbItems = items;
    box.hidden = false;
    document.documentElement.style.overflow = 'hidden';
    show(i);
    (box.querySelector('.lb-close') as HTMLElement).focus();
  }

  function closeLightbox() {
    if (!lb) return;
    lb.hidden = true;
    lb.querySelector('.lb-media')?.replaceChildren();
    document.documentElement.style.overflow = '';
    lastFocus?.focus();
  }

  function initGallery(root: HTMLElement) {
    if (root.dataset.ready) return;
    root.dataset.ready = '1';

    root.querySelectorAll<HTMLVideoElement>('video.js-player').forEach((v) => {
      players.set(
        v,
        new Plyr(v, {
          controls: ['play-large', 'play', 'progress', 'current-time', 'mute', 'fullscreen'],
          ratio: '16:9',
          muted: true,
          loop: { active: true },
        }),
      );
    });

    const stageItems = [...root.querySelectorAll<HTMLElement>('.stage-item')];
    const thumbs = [...root.querySelectorAll<HTMLButtonElement>('.thumb')];
    const caption = root.querySelector('.stage-caption') as HTMLElement;
    // Only images go to the full-screen viewer; videos have their own player.
    const imageButtons = stageItems.filter((el) => !el.classList.contains('is-video'));
    const imageItems: Item[] = imageButtons.map((b) => ({
      full: b.dataset.full ?? '',
      caption: b.dataset.caption ?? '',
    }));
    let current = 0;

    const activate = (i: number) => {
      if (i === current) return;
      const prevVideo = stageItems[current]?.querySelector('video');
      if (prevVideo) players.get(prevVideo)?.pause();
      stageItems.forEach((el, k) => {
        el.classList.toggle('active', k === i);
        if (el instanceof HTMLButtonElement) el.tabIndex = k === i ? 0 : -1;
      });
      thumbs.forEach((t, k) => t.classList.toggle('active', k === i));
      caption.textContent = thumbs[i]?.dataset.caption ?? '';
      current = i;
    };

    thumbs.forEach((t, i) => {
      t.addEventListener('mouseenter', () => activate(i));
      t.addEventListener('focus', () => activate(i));
      t.addEventListener('click', () => activate(i));
    });

    imageButtons.forEach((b, k) => {
      b.addEventListener('click', () => openLightbox(imageItems, k));
    });
  }

  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLElement>('[data-gallery]').forEach(initGallery);
  });
</script>

<style>
  .gallery {
    margin-top: 2rem;
    --plyr-color-main: var(--global-theme-color);
  }

  .plate {
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    padding: 10px;
    border: 1px solid var(--global-divider-color);
    border-radius: 6px;
    background: var(--global-card-bg-color);
    overflow: hidden;
    transition: border-color 0.2s ease;
  }

  button.plate {
    cursor: zoom-in;
  }

  button.plate:hover,
  button.plate:focus-visible {
    border-color: var(--global-theme-color);
    outline: none;
  }

  .plate img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .stage-item {
    aspect-ratio: 16 / 10;
    display: none;
  }

  .stage-item.active {
    display: grid;
  }

  .stage-item.is-video {
    aspect-ratio: auto;
    padding: 0;
    background: #000;
    border-color: transparent;
  }

  .stage-item.is-video :global(.plyr) {
    width: 100%;
    border-radius: 6px;
  }

  .zoom-hint {
    position: absolute;
    right: 10px;
    bottom: 10px;
    padding: 3px 9px;
    border-radius: 4px;
    background: rgba(0, 0, 0, 0.6);
    color: #fff;
    font-size: 0.72rem;
    opacity: 0;
    transition: opacity 0.2s ease;
    pointer-events: none;
  }

  button.plate:hover .zoom-hint,
  button.plate:focus-visible .zoom-hint {
    opacity: 1;
  }

  .stage-caption {
    margin: 0.7rem 0 0;
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--global-text-color);
    min-height: 1.6em;
  }

  .thumbs {
    list-style: none;
    margin: 0.9rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(96px, 1fr));
    gap: 8px;
  }

  .thumb {
    aspect-ratio: 4 / 3;
    padding: 4px;
    cursor: pointer;
    opacity: 0.75;
  }

  .thumb:hover,
  .thumb.active {
    opacity: 1;
    border-color: var(--global-theme-color);
  }

  .thumb.active {
    box-shadow: inset 0 0 0 1px var(--global-theme-color);
  }

  .thumb-play {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: #fff;
    pointer-events: none;
  }

  .thumb-play svg {
    width: 22px;
    height: 22px;
    padding: 6px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.55);
  }

  .thumb-video {
    font-size: 0.75rem;
    color: var(--global-text-color-light);
  }

  /* Lightbox is created at runtime and appended to <body>, so it needs global styles. */
  :global(.lightbox) {
    position: fixed;
    inset: 0;
    z-index: 300;
    display: grid;
    grid-template-columns: 3rem 1fr 3rem;
    grid-template-rows: 1fr auto;
    align-items: center;
    gap: 0.75rem;
    padding: 4vh 3vw;
    background: rgba(10, 10, 12, 0.92);
  }

  :global(.lightbox[hidden]) {
    display: none;
  }

  :global(.lb-media) {
    grid-column: 2;
    grid-row: 1;
    display: grid;
    place-items: center;
    height: 100%;
    min-height: 0;
  }

  :global(.lb-media img) {
    max-width: 100%;
    max-height: 82vh;
    object-fit: contain;
    background: #fff;
    border-radius: 4px;
  }

  :global(.lb-caption) {
    grid-column: 1 / -1;
    grid-row: 2;
    margin: 0 auto;
    max-width: 60rem;
    color: #e8e8e8;
    font-size: 0.95rem;
    text-align: center;
  }

  :global(.lb-close) {
    position: absolute;
    top: 0.75rem;
    right: 1rem;
    font-size: 2rem;
    line-height: 1;
    color: #fff;
    background: none;
    border: none;
    cursor: pointer;
  }

  :global(.lb-nav) {
    grid-row: 1;
    font-size: 2.5rem;
    color: #fff;
    background: none;
    border: none;
    cursor: pointer;
  }

  :global(.lb-prev) {
    grid-column: 1;
  }

  :global(.lb-next) {
    grid-column: 3;
  }

  :global(.lb-nav[hidden]) {
    visibility: hidden;
  }
</style>
