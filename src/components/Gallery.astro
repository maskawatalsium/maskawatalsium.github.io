---
/**
 * Figure gallery: one large "stage" plus a thumbnail rail.
 * Hovering or focusing a thumbnail swaps the stage; clicking the stage opens a
 * lightbox with the caption. Figures sit on uniform plates and are never cropped
 * (object-fit: contain). Videos play muted on hover and with controls in the lightbox.
 */
import { withBase } from '@utils/base';

export interface GalleryFigure {
  src: string;
  type?: 'image' | 'video';
  poster?: string;
  caption: string;
  alt?: string;
}

interface Props {
  figures: GalleryFigure[];
  /** Short prefix for figure numbers, e.g. "R1" → "Fig. R1.2". */
  label: string;
}

const { figures, label } = Astro.props;

/** Small pre-generated thumbnail: /assets/img/thumbs/<basename>.jpg */
const thumbOf = (path: string) =>
  withBase(
    `/assets/img/thumbs/${path
      .split('/')
      .pop()
      ?.replace(/\.[^.]+$/, '')}.jpg`,
  );

const items = figures.map((f, i) => ({
  ...f,
  type: f.type ?? 'image',
  url: withBase(f.src),
  posterUrl: f.poster ? withBase(f.poster) : undefined,
  thumbUrl:
    (f.type ?? 'image') === 'video' ? (f.poster ? thumbOf(f.poster) : undefined) : thumbOf(f.src),
  num: `Fig. ${label}.${i + 1}`,
  alt: f.alt ?? f.caption,
}));
---

<div class="gallery" data-gallery>
  <div class="stage">
    {
      items.map((f, i) => (
        <button
          type="button"
          class:list={['plate', 'stage-item', { active: i === 0 }]}
          data-index={i}
          data-type={f.type}
          data-full={f.url}
          data-caption={`${f.num} — ${f.caption}`}
          aria-label={`Enlarge: ${f.alt}`}
          tabindex={i === 0 ? 0 : -1}
        >
          {f.type === 'video' ? (
            <video
              src={f.url}
              poster={f.posterUrl}
              muted
              loop
              playsinline
              preload="none"
              aria-hidden="true"
            />
          ) : (
            <img src={f.url} alt={f.alt} loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
          )}
          {f.type === 'video' && (
            <span class="play-cue mono">▶ hover to play · click to enlarge</span>
          )}
          <span class="zoom-hint mono">Expand</span>
        </button>
      ))
    }
  </div>
  <p class="stage-caption">
    <span class="fig-n mono">{items[0]?.num}</span>
    <span class="cap-text">{items[0]?.caption}</span>
  </p>

  {
    items.length > 1 && (
      <ol class="thumbs" aria-label="Figures">
        {items.map((f, i) => (
          <li>
            <button
              type="button"
              class:list={['plate', 'thumb', { active: i === 0 }]}
              data-index={i}
              data-num={f.num}
              data-caption={f.caption}
              aria-label={`Show figure ${i + 1}: ${f.alt}`}
            >
              {f.thumbUrl ? (
                <img
                  src={f.thumbUrl}
                  alt=""
                  loading="lazy"
                  decoding="async"
                  onerror={`this.onerror=null;this.src='${f.posterUrl ?? f.url}'`}
                />
              ) : (
                <span class="thumb-video mono">video</span>
              )}
              {f.type === 'video' && (
                <span class="thumb-play" aria-hidden="true">
                  ▶
                </span>
              )}
            </button>
          </li>
        ))}
      </ol>
    )
  }
</div>

<script>
  type Item = { type: string; full: string; caption: string };

  let lb: HTMLDivElement | null = null;
  let lbItems: Item[] = [];
  let lbIndex = 0;
  let lastFocus: HTMLElement | null = null;

  function ensureLightbox(): HTMLDivElement {
    if (lb && document.body.contains(lb)) return lb;
    lb = document.createElement('div');
    lb.className = 'lightbox';
    lb.setAttribute('role', 'dialog');
    lb.setAttribute('aria-modal', 'true');
    lb.setAttribute('aria-label', 'Figure viewer');
    lb.hidden = true;

    const close = document.createElement('button');
    close.type = 'button';
    close.className = 'lb-close';
    close.setAttribute('aria-label', 'Close');
    close.textContent = '×';

    const prev = document.createElement('button');
    prev.type = 'button';
    prev.className = 'lb-nav lb-prev';
    prev.setAttribute('aria-label', 'Previous figure');
    prev.textContent = '‹';

    const next = document.createElement('button');
    next.type = 'button';
    next.className = 'lb-nav lb-next';
    next.setAttribute('aria-label', 'Next figure');
    next.textContent = '›';

    const media = document.createElement('div');
    media.className = 'lb-media';
    const cap = document.createElement('p');
    cap.className = 'lb-caption';

    lb.append(close, prev, media, next, cap);
    document.body.appendChild(lb);

    close.addEventListener('click', closeLightbox);
    prev.addEventListener('click', () => show(lbIndex - 1));
    next.addEventListener('click', () => show(lbIndex + 1));
    lb.addEventListener('click', (e) => {
      if (e.target === lb) closeLightbox();
    });
    document.addEventListener('keydown', (e) => {
      if (!lb || lb.hidden) return;
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowLeft') show(lbIndex - 1);
      if (e.key === 'ArrowRight') show(lbIndex + 1);
    });
    return lb;
  }

  function show(i: number) {
    if (!lb || lbItems.length === 0) return;
    lbIndex = (i + lbItems.length) % lbItems.length;
    const it = lbItems[lbIndex];
    const media = lb.querySelector('.lb-media') as HTMLDivElement;
    const cap = lb.querySelector('.lb-caption') as HTMLParagraphElement;
    media.replaceChildren();
    if (it.type === 'video') {
      const v = document.createElement('video');
      v.src = it.full;
      v.controls = true;
      v.autoplay = true;
      v.muted = true;
      v.loop = true;
      v.playsInline = true;
      media.appendChild(v);
    } else {
      const img = document.createElement('img');
      img.src = it.full;
      img.alt = it.caption;
      media.appendChild(img);
    }
    cap.textContent = it.caption;
    const multi = lbItems.length > 1;
    (lb.querySelector('.lb-prev') as HTMLElement).hidden = !multi;
    (lb.querySelector('.lb-next') as HTMLElement).hidden = !multi;
  }

  function openLightbox(items: Item[], i: number) {
    lastFocus = document.activeElement as HTMLElement | null;
    const box = ensureLightbox();
    lbItems = items;
    box.hidden = false;
    document.documentElement.style.overflow = 'hidden';
    show(i);
    (box.querySelector('.lb-close') as HTMLElement).focus();
  }

  function closeLightbox() {
    if (!lb) return;
    lb.hidden = true;
    lb.querySelector('.lb-media')?.replaceChildren();
    document.documentElement.style.overflow = '';
    lastFocus?.focus();
  }

  function initGallery(root: HTMLElement) {
    if (root.dataset.ready) return;
    root.dataset.ready = '1';
    const stageItems = [...root.querySelectorAll<HTMLButtonElement>('.stage-item')];
    const thumbs = [...root.querySelectorAll<HTMLButtonElement>('.thumb')];
    const num = root.querySelector('.stage-caption .fig-n') as HTMLElement;
    const capText = root.querySelector('.stage-caption .cap-text') as HTMLElement;
    const items: Item[] = stageItems.map((b) => ({
      type: b.dataset.type ?? 'image',
      full: b.dataset.full ?? '',
      caption: b.dataset.caption ?? '',
    }));
    let current = 0;

    const activate = (i: number) => {
      if (i === current) return;
      stageItems[current]?.querySelector('video')?.pause();
      stageItems.forEach((b, k) => {
        b.classList.toggle('active', k === i);
        b.tabIndex = k === i ? 0 : -1;
      });
      thumbs.forEach((t, k) => t.classList.toggle('active', k === i));
      const t = thumbs[i];
      if (t) {
        num.textContent = t.dataset.num ?? '';
        capText.textContent = t.dataset.caption ?? '';
      }
      current = i;
    };

    thumbs.forEach((t, i) => {
      t.addEventListener('mouseenter', () => activate(i));
      t.addEventListener('focus', () => activate(i));
      t.addEventListener('click', () => {
        activate(i);
        openLightbox(items, i);
      });
    });

    stageItems.forEach((b, i) => {
      b.addEventListener('click', () => openLightbox(items, i));
      const v = b.querySelector('video');
      if (v) {
        b.addEventListener('mouseenter', () => {
          if (b.classList.contains('active')) void v.play().catch(() => undefined);
        });
        b.addEventListener('mouseleave', () => v.pause());
      }
    });
  }

  function initAll() {
    document.querySelectorAll<HTMLElement>('[data-gallery]').forEach(initGallery);
  }

  document.addEventListener('astro:page-load', initAll);
</script>

<style>
  .gallery {
    margin-top: 1.75rem;
  }

  .plate {
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    padding: 10px;
    border: 1px solid var(--global-divider-color);
    border-radius: 4px;
    background: var(--global-card-bg-color, var(--global-bg-color));
    cursor: zoom-in;
    overflow: hidden;
    transition: border-color 0.2s ease;
  }

  .plate:hover,
  .plate:focus-visible {
    border-color: var(--global-theme-color);
    outline: none;
  }

  .plate img,
  .plate video {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .stage {
    position: relative;
  }

  .stage-item {
    aspect-ratio: 16 / 10;
    display: none;
  }

  .stage-item.active {
    display: grid;
  }

  .zoom-hint,
  .play-cue {
    position: absolute;
    padding: 3px 8px;
    border-radius: 3px;
    background: rgba(0, 0, 0, 0.62);
    color: #fff;
    font-size: 0.68rem;
    pointer-events: none;
  }

  .zoom-hint {
    right: 10px;
    bottom: 10px;
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .plate:hover .zoom-hint,
  .plate:focus-visible .zoom-hint {
    opacity: 1;
  }

  .play-cue {
    left: 10px;
    bottom: 10px;
  }

  .stage-caption {
    margin: 0.6rem 0 0;
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--global-text-color-light);
    min-height: 2.6em;
  }

  .fig-n {
    color: var(--global-theme-color);
    margin-right: 0.5rem;
    font-size: 0.75rem;
  }

  .thumbs {
    list-style: none;
    margin: 0.75rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(92px, 1fr));
    gap: 8px;
  }

  .thumb {
    aspect-ratio: 4 / 3;
    padding: 4px;
    cursor: pointer;
  }

  .thumb.active {
    border-color: var(--global-theme-color);
    box-shadow: inset 0 0 0 1px var(--global-theme-color);
  }

  .thumb-play {
    position: absolute;
    left: 6px;
    bottom: 4px;
    font-size: 0.7rem;
    color: #fff;
    background: rgba(0, 0, 0, 0.6);
    padding: 0 4px;
    border-radius: 2px;
  }

  .thumb-video {
    font-size: 0.7rem;
    color: var(--global-text-color-light);
  }

  .mono {
    font-family: var(--font-mono, 'Source Code Pro', monospace);
  }

  /* Lightbox is created at runtime and appended to <body>, so it needs global styles. */
  :global(.lightbox) {
    position: fixed;
    inset: 0;
    z-index: 300;
    display: grid;
    grid-template-columns: 3rem 1fr 3rem;
    grid-template-rows: 1fr auto;
    align-items: center;
    gap: 0.75rem;
    padding: 4vh 3vw;
    background: rgba(10, 10, 12, 0.92);
  }

  :global(.lightbox[hidden]) {
    display: none;
  }

  :global(.lb-media) {
    grid-column: 2;
    grid-row: 1;
    display: grid;
    place-items: center;
    height: 100%;
    min-height: 0;
  }

  :global(.lb-media img),
  :global(.lb-media video) {
    max-width: 100%;
    max-height: 82vh;
    object-fit: contain;
    background: #fff;
    border-radius: 3px;
  }

  :global(.lb-media video) {
    background: #000;
  }

  :global(.lb-caption) {
    grid-column: 1 / -1;
    grid-row: 2;
    margin: 0 auto;
    max-width: 60rem;
    color: #e8e8e8;
    font-size: 0.9rem;
    text-align: center;
  }

  :global(.lb-close) {
    position: absolute;
    top: 0.75rem;
    right: 1rem;
    font-size: 2rem;
    line-height: 1;
    color: #fff;
    background: none;
    border: none;
    cursor: pointer;
  }

  :global(.lb-nav) {
    grid-row: 1;
    font-size: 2.5rem;
    color: #fff;
    background: none;
    border: none;
    cursor: pointer;
  }

  :global(.lb-prev) {
    grid-column: 1;
  }

  :global(.lb-next) {
    grid-column: 3;
  }

  :global(.lb-nav[hidden]) {
    visibility: hidden;
  }
</style>
