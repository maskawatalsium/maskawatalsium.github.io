---
/** Page header: a title line and an optional subtitle. */
interface Props {
  title: string;
  sub?: string;
}

const { title, sub } = Astro.props;
---

<header class="sec-head">
  <h1 class="sec-title">{title}</h1>
  {sub && <p class="sec-sub">{sub}</p>}
</header>

<style>
  .sec-head {
    margin-bottom: 1.25rem;
  }

  .sec-title {
    margin: 0 0 0.5rem;
    font-size: 2.1rem;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.015em;
    color: var(--global-text-color);
  }

  .sec-sub {
    margin: 0;
    max-width: 44em;
    font-size: 1.08rem;
    line-height: 1.6;
    color: var(--global-text-color-light);
  }
</style>
