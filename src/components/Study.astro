---
/**
 * One research study or project:
 * affiliation/date line · title · summary · text with an "at a glance" panel · gallery.
 */
import { withBase } from '@utils/base';
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';

import Gallery from './Gallery.astro';

interface Props {
  entry: CollectionEntry<'projects'>;
  /** Render the title as the page's h1 (project detail pages). */
  asPage?: boolean;
}

const { entry, asPage = false } = Astro.props;
const { Content } = await render(entry);
const { title, description, affiliation, period, methods, tools, status, figures, links } =
  entry.data;

const hasFacts = Boolean(status || methods?.length || tools?.length);
const resolve = (href: string) => (href.startsWith('/') ? withBase(href) : href);
const Title = asPage ? 'h1' : 'h2';
---

<article class:list={['study', { 'as-page': asPage }]} id={entry.id}>
  <header class="study-head">
    {
      (affiliation || period) && (
        <p class="study-meta">
          {affiliation && <span class="meta-org">{affiliation}</span>}
          {period && <span class="meta-date">{period}</span>}
        </p>
      )
    }
    <Title class="study-title">{title}</Title>
    {description && <p class="study-sub">{description}</p>}
  </header>

  <div class:list={['study-grid', { 'no-facts': !hasFacts }]}>
    <div class="study-body prose">
      <Content />
      {
        links && links.length > 0 && (
          <p class="out-links">
            {links.map((l) => (
              <a
                href={resolve(l.href)}
                target={l.href.startsWith('http') ? '_blank' : undefined}
                rel={l.href.startsWith('http') ? 'noopener noreferrer' : undefined}
              >
                {l.label} <span aria-hidden="true">&rarr;</span>
              </a>
            ))}
          </p>
        )
      }
    </div>

    {
      hasFacts && (
        <aside class="study-facts" aria-label="At a glance">
          {status && <p class="fact-status">{status}</p>}
          {methods && methods.length > 0 && (
            <div class="fact">
              <h3>Methods</h3>
              <ul class="chips">
                {methods.map((m) => (
                  <li>{m}</li>
                ))}
              </ul>
            </div>
          )}
          {tools && tools.length > 0 && (
            <div class="fact">
              <h3>Tools</h3>
              <ul class="chips">
                {tools.map((t) => (
                  <li>{t}</li>
                ))}
              </ul>
            </div>
          )}
        </aside>
      )
    }
  </div>

  {figures && figures.length > 0 && <Gallery figures={figures} />}
</article>

<style>
  .study {
    padding: 3rem 0;
    border-top: 1px solid var(--global-divider-color);
    scroll-margin-top: 4.5rem;
  }

  .study.as-page {
    padding-top: 0.5rem;
    border-top: none;
  }

  .study-meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    margin: 0 0 0.55rem;
    font-size: 0.88rem;
  }

  .meta-org {
    color: var(--global-theme-color);
    font-weight: 500;
  }

  .meta-date {
    color: var(--global-text-color-light);
    font-variant-numeric: tabular-nums;
  }

  .study-title {
    margin: 0 0 0.6rem;
    font-size: 1.65rem;
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.01em;
    color: var(--global-text-color);
  }

  .as-page .study-title {
    font-size: 2rem;
  }

  .study-sub {
    margin: 0;
    max-width: 46em;
    font-size: 1.08rem;
    line-height: 1.6;
    color: var(--global-text-color-light);
  }

  .study-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 15.5rem;
    gap: 2.25rem;
    margin-top: 1.75rem;
    align-items: start;
  }

  .study-grid.no-facts {
    grid-template-columns: minmax(0, 1fr);
  }

  .study-body {
    font-size: 1.02rem;
    line-height: 1.75;
    color: var(--global-text-color);
  }

  .study-body :global(p:last-child),
  .study-body :global(ul:last-child) {
    margin-bottom: 0;
  }

  .out-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin: 1.1rem 0 0 !important;
    font-size: 0.95rem;
  }

  .out-links a {
    color: var(--global-theme-color);
    font-weight: 500;
    text-decoration: none;
  }

  .out-links a:hover {
    text-decoration: underline;
  }

  .study-facts {
    padding: 1.1rem 1.2rem;
    border: 1px solid var(--global-divider-color);
    border-radius: 8px;
    background: var(--global-card-bg-color);
  }

  .fact-status {
    margin: 0 0 1rem;
    padding-bottom: 0.9rem;
    border-bottom: 1px solid var(--global-divider-color);
    font-size: 0.9rem;
    font-weight: 500;
    line-height: 1.45;
    color: var(--global-text-color);
  }

  .fact + .fact {
    margin-top: 1rem;
  }

  .fact h3 {
    margin: 0 0 0.5rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--global-text-color-light);
  }

  .chips {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
  }

  .chips li {
    margin: 0;
    padding: 0.2rem 0.6rem;
    border: 1px solid var(--global-divider-color);
    border-radius: 999px;
    background: var(--global-bg-color);
    font-size: 0.82rem;
    line-height: 1.4;
    color: var(--global-text-color);
  }

  @media (max-width: 760px) {
    .study {
      padding: 2.25rem 0;
    }

    .study-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.5rem;
    }

    .study-title {
      font-size: 1.4rem;
    }
  }
</style>
