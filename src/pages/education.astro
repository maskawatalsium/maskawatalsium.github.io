---
import SectionHead from '@components/SectionHead.astro';
import { site } from '@config/site';
import Page from '@layouts/Page.astro';
import { withBase } from '@utils/base';
import type { RenderCV, RenderCVEntry } from '@utils/cv';
import { formatDateRange } from '@utils/cv';
import yaml from 'js-yaml';

import cvRaw from '../data/cv.yml?raw';

const cv = (yaml.load(cvRaw) as RenderCV).cv;
const education = (cv.sections.education ?? []) as RenderCVEntry[];
const experience = (cv.sections.experience ?? []) as RenderCVEntry[];

const range = (e: RenderCVEntry) =>
  e.start_date ? formatDateRange(e.start_date, e.end_date) : String(e.date ?? '');

// Group consecutive roles at the same company (LinkedIn style).
type Group = { company: string; roles: RenderCVEntry[] };
const groups: Group[] = [];
for (const e of experience) {
  const last = groups[groups.length - 1];
  if (last && last.company === e.company) last.roles.push(e);
  else groups.push({ company: e.company ?? '', roles: [e] });
}
---

<Page title="Education" description={`Education and experience of ${site.author.name}`}>
  <div class="post">
    <SectionHead
      title="Education & experience"
      sub="Mechanical engineering at NCEPU, now aerospace engineering at BIT."
    />

    <h2 class="block-title">Education</h2>
    <div class="degrees">
      {
        education.map((e) => (
          <article class="degree">
            <span class="date-pill">{range(e)}</span>
            <h3 class="degree-title">
              {e.degree} in {e.area}
            </h3>
            <p class="degree-org">{e.institution}</p>
            {e.location && <p class="degree-loc">{e.location}</p>}
            {e.highlights && (
              <ul class="points">
                {e.highlights.map((h) => (
                  <li>{h}</li>
                ))}
              </ul>
            )}
          </article>
        ))
      }
    </div>

    <h2 class="block-title">Experience</h2>
    <ol class="timeline">
      {
        groups.map((g) => (
          <li class="tl-group">
            <span class="tl-dot" aria-hidden="true" />
            <h3 class="tl-company">{g.company}</h3>
            {g.roles.map((r) => (
              <div class="tl-role">
                <div class="role-head">
                  <p class="role-title">{r.position}</p>
                  <span class="date-pill">{range(r)}</span>
                </div>
                {r.location && <p class="role-loc">{r.location}</p>}
                {r.highlights && (
                  <ul class="points">
                    {r.highlights.map((h) => (
                      <li>{h}</li>
                    ))}
                  </ul>
                )}
              </div>
            ))}
          </li>
        ))
      }
    </ol>

    <p class="cv-links">
      <a href={withBase(site.cv.pdfPath)} target="_blank" rel="noopener noreferrer"
        >Download CV (PDF) <span aria-hidden="true">&rarr;</span></a
      >
      <a href={withBase('/cv/')}>Full CV page <span aria-hidden="true">&rarr;</span></a>
    </p>
  </div>
</Page>

<style>
  .post {
    padding-top: 0;
  }

  .block-title {
    margin: 2.25rem 0 1rem;
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--global-text-color);
  }

  .date-pill {
    display: inline-block;
    padding: 0.15rem 0.65rem;
    border: 1px solid var(--global-theme-color);
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 500;
    line-height: 1.5;
    white-space: nowrap;
    color: var(--global-theme-color);
    font-variant-numeric: tabular-nums;
  }

  .points {
    margin: 0.7rem 0 0;
    padding-left: 1.15rem;
    list-style: disc;
    font-size: 0.96rem;
    line-height: 1.65;
    color: var(--global-text-color);
  }

  .points li {
    margin: 0.25rem 0;
  }

  .points li::marker {
    color: var(--global-theme-color);
  }

  /* Degrees */
  .degrees {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(19rem, 1fr));
    gap: 1rem;
  }

  .degree {
    padding: 1.25rem 1.35rem;
    border: 1px solid var(--global-divider-color);
    border-radius: 10px;
    background: var(--global-card-bg-color);
  }

  .degree-title {
    margin: 0.75rem 0 0.3rem;
    font-size: 1.2rem;
    font-weight: 700;
    line-height: 1.3;
    color: var(--global-text-color);
  }

  .degree-org {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
    color: var(--global-text-color);
  }

  .degree-loc,
  .role-loc {
    margin: 0.1rem 0 0;
    font-size: 0.9rem;
    color: var(--global-text-color-light);
  }

  /* Experience timeline */
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0 0 0 1.5rem;
    border-left: 2px solid var(--global-divider-color);
  }

  .tl-group {
    position: relative;
    padding: 0 0 1.9rem;
  }

  .tl-group:last-child {
    padding-bottom: 0.25rem;
  }

  .tl-dot {
    position: absolute;
    left: calc(-1.5rem - 7px);
    top: 0.35rem;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--global-bg-color);
    border: 2px solid var(--global-theme-color);
  }

  .tl-company {
    margin: 0 0 0.5rem;
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1.35;
    color: var(--global-text-color);
  }

  .tl-role + .tl-role {
    margin-top: 1.1rem;
    padding-top: 1rem;
    border-top: 1px dashed var(--global-divider-color);
  }

  .role-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.4rem 1rem;
  }

  .role-title {
    margin: 0;
    font-size: 1.02rem;
    font-weight: 600;
    color: var(--global-text-color);
  }

  .cv-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-top: 2.25rem;
    font-size: 0.98rem;
  }

  .cv-links a {
    color: var(--global-theme-color);
    font-weight: 500;
    text-decoration: none;
  }

  .cv-links a:hover {
    text-decoration: underline;
  }
</style>
