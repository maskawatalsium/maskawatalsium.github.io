---
import SectionHead from '@components/SectionHead.astro';
import Study from '@components/Study.astro';
import { site } from '@config/site';
import Page from '@layouts/Page.astro';
import { getCollection } from 'astro:content';

// Research entries live on /research/; this page lists the remaining projects.
const projects = (await getCollection('projects', (p) => p.data.category !== 'research')).sort(
  (a, b) => (a.data.importance ?? 999) - (b.data.importance ?? 999),
);
---

<Page title="Projects" description={`Projects by ${site.author.name}`}>
  <div class="post">
    <SectionHead
      num="03"
      name="Projects"
      title="Design, modelling and control projects"
      sub={site.pages.projects.description}
    />

    {
      projects.map((entry, i) => (
        <Study entry={entry} code={`P/${String(i + 1).padStart(2, '0')}`} />
      ))
    }
  </div>
</Page>

<style>
  .post {
    padding-top: 0;
  }
</style>
