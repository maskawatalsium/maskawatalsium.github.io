---
import SectionHead from '@components/SectionHead.astro';
import Study from '@components/Study.astro';
import { site } from '@config/site';
import Page from '@layouts/Page.astro';
import { getAuthors, getTitle, getVenue, getYear, parseBibtex } from '@utils/bibtex';
import { getCollection } from 'astro:content';

import bibRaw from '../../data/papers.bib?raw';

const entries = (await getCollection('projects', (p) => p.data.category === 'research')).sort(
  (a, b) => (a.data.importance ?? 999) - (b.data.importance ?? 999),
);

const selfName = site.publications.authorLastName ?? '';
const papers = parseBibtex(bibRaw).map((e) => {
  const authors = getAuthors(e)
    .split(', ')
    .map((a) => ({ name: a, self: selfName !== '' && a.endsWith(selfName) }));
  const f = e.fields;
  const volume = [f.volume, f.number ? `(${f.number})` : ''].join('');
  return {
    key: e.key,
    title: getTitle(e),
    authors,
    venue: getVenue(e),
    year: getYear(e),
    details: [volume, f.pages].filter(Boolean).join(', '),
    doi: f.doi,
    abbr: f.abbr,
  };
});
---

<Page title="Research" description={`Research by ${site.author.name}`}>
  <div class="post">
    <SectionHead
      title="Plasma sources and diagnostics for electric propulsion"
      sub={site.pages.research.description}
    />

    {entries.map((entry) => <Study entry={entry} />)}

    <section id="publications" class="pubs">
      <p class="pubs-kicker">Earlier work</p>
      <h2 class="pubs-title">Publications</h2>
      <p class="pubs-sub">Journal papers from my undergraduate studies.</p>
      <ol class="pub-list">
        {
          papers.map((p) => (
            <li class="pub">
              <span class="pub-year">{p.year}</span>
              <div class="pub-body">
                <p class="pub-title">
                  {p.doi ? (
                    <a href={`https://doi.org/${p.doi}`} target="_blank" rel="noopener noreferrer">
                      {p.title}
                    </a>
                  ) : (
                    p.title
                  )}
                </p>
                <p class="pub-authors">
                  {p.authors.map((a, k) => (
                    <>
                      {a.self ? <strong>{a.name}</strong> : a.name}
                      {k < p.authors.length - 1 ? ', ' : ''}
                    </>
                  ))}
                </p>
                <p class="pub-venue">
                  <em>{p.venue}</em>
                  {p.details && `, ${p.details}`}
                  {p.doi && (
                    <>
                      {' · '}
                      <a
                        class="mono pub-doi"
                        href={`https://doi.org/${p.doi}`}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        doi:{p.doi}
                      </a>
                    </>
                  )}
                </p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>
  </div>
</Page>

<style>
  .post {
    padding-top: 0;
  }

  .mono {
    font-family: var(--font-mono);
  }

  .pubs {
    padding: 2.75rem 0 1rem;
    border-top: 1px solid var(--global-divider-color);
    scroll-margin-top: 4.5rem;
  }

  .pubs-kicker {
    margin: 0 0 0.45rem;
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--global-theme-color);
  }

  .pubs-title {
    margin: 0 0 0.4rem;
    font-size: 1.65rem;
    font-weight: 700;
  }

  .pubs-sub {
    margin: 0 0 1.25rem;
    color: var(--global-text-color-light);
  }

  .pub-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--global-divider-color);
  }

  .pub {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr);
    gap: 1rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--global-divider-color);
  }

  .pub-year {
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--global-theme-color);
    font-variant-numeric: tabular-nums;
    padding-top: 0.05rem;
  }

  .pub-body p {
    margin: 0 0 0.2rem;
  }

  .pub-title {
    font-weight: 600;
    line-height: 1.45;
  }

  .pub-title a {
    color: var(--global-text-color);
    text-decoration: none;
  }

  .pub-title a:hover {
    color: var(--global-theme-color);
  }

  .pub-authors,
  .pub-venue {
    font-size: 0.92rem;
    color: var(--global-text-color-light);
  }

  .pub-authors strong {
    color: var(--global-text-color);
  }

  .pub-doi {
    font-size: 0.8rem;
    color: var(--global-theme-color);
    text-decoration: none;
  }

  @media (max-width: 640px) {
    .pub {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.25rem;
    }
  }
</style>
