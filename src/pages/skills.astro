---
import Gallery from '@components/Gallery.astro';
import SectionHead from '@components/SectionHead.astro';
import { site } from '@config/site';
import Page from '@layouts/Page.astro';
import type { RenderCV, RenderCVEntry } from '@utils/cv';
import { getCollection } from 'astro:content';
import yaml from 'js-yaml';

import cvRaw from '../data/cv.yml?raw';
import skillsRaw from '../data/skills.yml?raw';

type Group = { group: string; items: string[] };
const groups = yaml.load(skillsRaw) as Group[];

// Tools named in research/project entries — matching skills are highlighted.
const used = (await getCollection('projects'))
  .flatMap((p) => p.data.tools ?? [])
  .map((t) => t.toLowerCase());
const isUsed = (item: string) => {
  const s = item.toLowerCase();
  return used.some((t) => s.includes(t) || t.includes(s));
};

const sections = (yaml.load(cvRaw) as RenderCV).cv.sections;
// Newest first; undated entries last.
const firstYear = (a: RenderCVEntry) => Number(String(a.date ?? '').match(/\d{4}/)?.[0] ?? 0);
const byYear = (a: RenderCVEntry, b: RenderCVEntry) => firstYear(b) - firstYear(a);
const awards = ((sections.awards ?? []) as RenderCVEntry[]).sort(byYear);
const recognition = ((sections.recognition ?? []) as RenderCVEntry[]).sort(byYear);
const seminars = ((sections.seminars ?? []) as RenderCVEntry[]).sort(byYear);

// Scans of the certificates behind the lists above (public/assets/img/certificates/).
const cert = (n: number, caption: string) => ({
  src: `/assets/img/certificates/cert-${String(n).padStart(2, '0')}.jpg`,
  caption,
});
const certificates = [
  cert(9, 'First Prize, 52nd Victory Day Cultural Competition 2023 — BCYSA'),
  cert(5, 'Certificate of Recognition, BCYSA Campus Ambassador (Jul 2023 – Aug 2024)'),
  cert(1, "Certificate of Appreciation — International Students' Union, NCEPU (2024)"),
  cert(8, 'Letter confirming membership of the ISU Academic Department (Dec 2023 – Jul 2024)'),
  cert(7, 'Volunteer letter — New Student Registration, Aug 2024'),
  cert(6, 'Volunteer letter — Graduate Students Convocation 2024'),
  cert(4, 'Volunteer Certificate — 11th Inspiration English Club (Jun 2024)'),
  cert(3, 'Participation Certificate — 5th International Cultural Festival, NCEPU (May 2024)'),
  cert(10, 'Participation — Writer of the Campus 2023, BCYSA'),
  cert(
    2,
    'Certificate of Recognition — SRII online seminar "Innovating Global Knowledge Economy" (May 2024)',
  ),
  cert(14, 'Attendance — 2024 National Science Popularization Day webinar (Sep 2024)'),
  cert(11, 'Attendance — Master and Ph.D. Research and Thesis Guidance Seminar (Jun 2024)'),
  cert(12, 'Attendance — 2024 National Science and Technology Workers Day Seminar (May 2024)'),
  cert(13, 'Attendance — University of Liverpool lecture by Prof. Alan Marshall (Mar 2024)'),
];
---

<Page title="Skills" description={`Skills and achievements of ${site.author.name}`}>
  <div class="post">
    <SectionHead
      title="Skills"
      sub="Simulation, design and laboratory tools. Highlighted skills are used in the research and projects on this site."
    />

    <dl class="skill-rows">
      {
        groups.map((g) => (
          <div class="skill-row">
            <dt>{g.group}</dt>
            <dd>
              <ul class="chips">
                {g.items.map((item) => (
                  <li class:list={{ used: isUsed(item) }}>
                    {item}
                    {isUsed(item) && <span class="visually-hidden"> (used in my work)</span>}
                  </li>
                ))}
              </ul>
            </dd>
          </div>
        ))
      }
    </dl>

    <h2 class="block-title">Honours &amp; awards</h2>
    <ol class="awards">
      {
        awards.map((a) => (
          <li class="award">
            {a.date ? <span class="year-pill">{a.date}</span> : <span />}
            <div>
              <p class="award-name">{a.name}</p>
              {a.issuer && <p class="award-issuer">{a.issuer}</p>}
              {a.highlights?.[0] && <p class="award-note">{a.highlights[0]}</p>}
            </div>
          </li>
        ))
      }
    </ol>

    {
      recognition.length > 0 && (
        <>
          <h2 class="block-title">Recognition &amp; volunteering</h2>
          <ul class="recog">
            {recognition.map((r) => (
              <li>
                <span class="recog-year">{r.date}</span>
                <span>
                  <strong>{r.name}</strong>
                  {r.issuer && <span class="recog-issuer"> — {r.issuer}</span>}
                </span>
              </li>
            ))}
          </ul>
        </>
      )
    }

    {
      seminars.length > 0 && (
        <>
          <h2 class="block-title">Seminars &amp; lectures</h2>
          <ul class="recog">
            {seminars.map((r) => (
              <li>
                <span class="recog-year">{r.date}</span>
                <span>
                  <strong>{r.name}</strong>
                  {r.issuer && <span class="recog-issuer"> — {r.issuer}</span>}
                </span>
              </li>
            ))}
          </ul>
        </>
      )
    }

    <h2 class="block-title">Certificates</h2>
    <p class="block-sub">Click a certificate to view it full size.</p>
    <Gallery figures={certificates} />
  </div>
</Page>

<style>
  .post {
    padding-top: 0;
  }

  .skill-rows {
    margin: 1.25rem 0 0;
    border-top: 1px solid var(--global-divider-color);
  }

  .skill-row {
    display: grid;
    grid-template-columns: 13rem minmax(0, 1fr);
    gap: 1.25rem;
    padding: 1.1rem 0;
    border-bottom: 1px solid var(--global-divider-color);
  }

  .skill-row dt {
    margin: 0;
    padding-top: 0.3rem;
    font-size: 1rem;
    font-weight: 700;
    color: var(--global-text-color);
  }

  .skill-row dd {
    margin: 0;
  }

  .chips {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
  }

  .chips li {
    margin: 0;
    padding: 0.3rem 0.8rem;
    border: 1px solid var(--global-divider-color);
    border-radius: 999px;
    background: var(--global-card-bg-color);
    font-size: 0.92rem;
    line-height: 1.4;
    color: var(--global-text-color);
  }

  .chips li.used {
    border-color: var(--global-theme-color);
    color: var(--global-theme-color);
    font-weight: 500;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .block-title {
    margin: 2.5rem 0 1rem;
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--global-text-color);
  }

  .block-sub {
    margin: -0.5rem 0 0;
    font-size: 0.95rem;
    color: var(--global-text-color-light);
  }

  .awards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }

  .award {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr);
    gap: 1rem;
    align-items: start;
    padding: 1rem 1.2rem;
    border: 1px solid var(--global-divider-color);
    border-radius: 10px;
    background: var(--global-card-bg-color);
  }

  .award p {
    margin: 0;
  }

  .year-pill {
    justify-self: start;
    padding: 0.15rem 0.65rem;
    border: 1px solid var(--global-theme-color);
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 500;
    white-space: nowrap;
    color: var(--global-theme-color);
    font-variant-numeric: tabular-nums;
  }

  .award-name {
    font-size: 1.02rem;
    font-weight: 700;
    line-height: 1.4;
    color: var(--global-text-color);
  }

  .award-issuer {
    margin-top: 0.1rem !important;
    font-size: 0.92rem;
    color: var(--global-text-color-light);
  }

  .award-note {
    margin-top: 0.35rem !important;
    font-size: 0.92rem;
    line-height: 1.55;
    color: var(--global-text-color);
  }

  .recog {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--global-divider-color);
  }

  .recog li {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr);
    gap: 1rem;
    padding: 0.65rem 0;
    border-bottom: 1px solid var(--global-divider-color);
    font-size: 0.95rem;
    color: var(--global-text-color);
  }

  .recog strong {
    font-weight: 600;
  }

  .recog-year {
    color: var(--global-theme-color);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }

  .recog-issuer {
    color: var(--global-text-color-light);
  }

  @media (max-width: 640px) {
    .skill-row,
    .award,
    .recog li {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.5rem;
    }
  }
</style>
